# Database Configuration
DB_TYPE=sqlite  # Options: sqlite, postgresql
# PostgreSQL connection URL (required if DB_TYPE=postgresql)
# Format: postgresql://username:password@host:port/database
# POSTGRES_URL=postgresql://user:pass@localhost:5432/govtech_repos

# SQLite Configuration (used if DB_TYPE=sqlite or if PostgreSQL connection fails)
SQLITE_PATH=government_repos.db
